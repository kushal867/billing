# PostgreSQL connection string (use a pooled URL on Vercel, e.g. Neon/Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kusbill?schema=public"
# Direct (non-pooled) URL used by `prisma migrate deploy`. Same as DATABASE_URL if you have no pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/kusbill?schema=public"
# Random string, at least 32 chars. Generate with: openssl rand -base64 48
SESSION_SECRET=""
# Used only by `npm run db:seed` to create the first owner login
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD=""
# Set to "false" to hide the public "Create account" page (existing users can still sign in)
ALLOW_SIGNUP="true"
