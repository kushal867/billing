# PostgreSQL connection string (use a pooled URL on Vercel, e.g. Neon/Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kusbill?schema=public"
# Direct (non-pooled) URL used by `prisma migrate deploy`. Same as DATABASE_URL if you have no pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/kusbill?schema=public"
# Random string, at least 32 chars. Generate with: openssl rand -base64 48
SESSION_SECRET=""
# Used only by `npm run db:seed` to create the first owner login
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD=""
# Set to "false" to hide the public "Create account" page (existing users can still sign in)
ALLOW_SIGNUP="true"

# --- Email (sign-up verification and "forgot password") ---------------------------------
# Public address of the site. Used in the links inside emails. REQUIRED in production if SMTP is set.
APP_URL="https://your-domain.example"
# Hostinger example: smtp.hostinger.com, port 465 (SSL). Create the mailbox in hPanel -> Emails.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Optional display sender, e.g. KusBill <no-reply@your-domain.example>
MAIL_FROM=""
# Email verification is enforced only while SMTP is configured. Set "false" to turn it off.
REQUIRE_EMAIL_VERIFICATION="true"
# NEVER set these on a real server (browser tests only): MAIL_TRANSPORT=memory, TEST_API_KEY
# Idle sign-out: minutes of inactivity before a session ends (default 60)
SESSION_IDLE_MINUTES="60"
